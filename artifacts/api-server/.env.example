# Required in production (Render Web Service)
PORT=3001
NODE_ENV=production
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
JWT_SECRET=change-me-min-16-chars

# Frontend origin(s) for CORS (comma-separated). Default includes game-reviews-web.onrender.com
CORS_ORIGIN=https://game-reviews-web.onrender.com

# Optional integrations
RAWG_API_KEY=
ITAD_API_KEY=
AI_INTEGRATIONS_ANTHROPIC_API_KEY=
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=
LOG_LEVEL=info

# OAuth (Google Cloud Console + Meta for Developers)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Public API base for OAuth callbacks, e.g. https://game-reviews-hub-api.onrender.com
OAUTH_CALLBACK_BASE_URL=
# Where to redirect after successful OAuth (defaults to first CORS_ORIGIN)
FRONTEND_URL=https://game-reviews-web.onrender.com
