# Required in production (Render Web Service)
PORT=3001
NODE_ENV=production
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
JWT_SECRET=change-me-min-16-chars

# Frontend origin(s) for CORS (comma-separated). Default includes game-reviews-web.onrender.com
CORS_ORIGIN=https://game-reviews-web.onrender.com

# Optional integrations
RAWG_API_KEY=
ITAD_API_KEY=
AI_INTEGRATIONS_ANTHROPIC_API_KEY=
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=
LOG_LEVEL=info
